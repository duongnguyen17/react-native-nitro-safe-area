+    inset-inline-start: env(nitro-safe-area-inset-left);
+
+    @variant rtl {
+        inset-inline-start: env(nitro-safe-area-inset-right);
+    }
+}
+
+@utility start-nitro-safe-or-* {
+    inset-inline-start: max(env(nitro-safe-area-inset-left), --spacing(--value(integer)));
+    inset-inline-start: max(env(nitro-safe-area-inset-left), --value([length], --spacing-*));
+
+    @variant rtl {
+        inset-inline-start: max(env(nitro-safe-area-inset-right), --spacing(--value(integer)));
+        inset-inline-start: max(env(nitro-safe-area-inset-right), --value([length], --spacing-*));
+    }
+}
+
+@utility start-nitro-safe-offset-* {
+    inset-inline-start: calc(env(nitro-safe-area-inset-left) + --spacing(--value(integer)));
+    inset-inline-start: calc(env(nitro-safe-area-inset-left) + --value([length], --spacing-*));
+
+    @variant rtl {
+        inset-inline-start: calc(env(nitro-safe-area-inset-right) + --spacing(--value(integer)));
+        inset-inline-start: calc(env(nitro-safe-area-inset-right) + --value([length], --spacing-*));
+    }
+}
+
+@utility end-nitro-safe {
+    inset-inline-end: env(nitro-safe-area-inset-right);
+
+    @variant rtl {
+        inset-inline-end: env(nitro-safe-area-inset-left);
+    }
+}
+
+@utility end-nitro-safe-or-* {
+    inset-inline-end: max(env(nitro-safe-area-inset-right), --spacing(--value(integer)));
+    inset-inline-end: max(env(nitro-safe-area-inset-right), --value([length], --spacing-*));
+
+    @variant rtl {
+        inset-inline-end: max(env(nitro-safe-area-inset-left), --spacing(--value(integer)));
+        inset-inline-end: max(env(nitro-safe-area-inset-left), --value([length], --spacing-*));
+    }
+}
+
+@utility end-nitro-safe-offset-* {
+    inset-inline-end: calc(env(nitro-safe-area-inset-right) + --spacing(--value(integer)));
+    inset-inline-end: calc(env(nitro-safe-area-inset-right) + --value([length], --spacing-*));
+
+    @variant rtl {
+        inset-inline-end: calc(env(nitro-safe-area-inset-left) + --spacing(--value(integer)));
+        inset-inline-end: calc(env(nitro-safe-area-inset-left) + --value([length], --spacing-*));
+    }
+}
+
+@custom-variant disabled {
+    &:disabled {
+        @slot;
+    }
+
+    &[aria-disabled="true"] {
+        @slot;
+    }
+
+    &[readonly] {
+        @slot;
+    }
+}
+
+@utility border-continuous {
+  border-curve: continuous;
+}
+
+@utility border-circular {
+  border-curve: circular;
+}
+
+@custom-variant light {
+   &:where(.light, .light *) {
+       @slot;
+   }
+
+   @media (prefers-color-scheme: light) {
+       &:not(:where(.light, .light *, .dark, .dark *)) {
+           @slot;
+       }
+   }
+}
+
+@custom-variant dark {
+   &:where(.dark, .dark *) {
+       @slot;
+   }
+
+   @media (prefers-color-scheme: dark) {
+       &:not(:where(.light, .light *, .dark, .dark *)) {
+           @slot;
+       }
+   }
+}
